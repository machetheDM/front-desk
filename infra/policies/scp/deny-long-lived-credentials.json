{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoIamUsersOrAccessKeys",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser", "iam:CreateAccessKey", "iam:UpdateAccessKey",
        "iam:CreateLoginProfile", "iam:UpdateLoginProfile", "iam:CreateServiceSpecificCredential"
      ],
      "Resource": "*"
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogsAreNeverDeletedOrUnlocked",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention",
        "s3:PutObjectRetention", "s3:PutObjectLegalHold", "s3:DeleteBucket"
      ],
      "Resource": ["arn:aws:s3:::frontdesk-org-trail-*", "arn:aws:s3:::frontdesk-org-trail-*/*"],
      "Condition": { "ArnNotLike": { "aws:PrincipalArn": ["arn:aws:iam::*:role/FrontDeskBreakGlass"] } }
    },
    {
      "Sid": "BucketSettingsOnlyThroughCdk",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy", "s3:DeleteBucketPolicy", "s3:PutBucketObjectLockConfiguration",
        "s3:PutLifecycleConfiguration", "s3:PutBucketVersioning", "s3:PutEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::frontdesk-org-trail-*",
      "Condition": { "ArnNotLike": { "aws:PrincipalArn": [
        "arn:aws:iam::*:role/FrontDeskBreakGlass",
        "arn:aws:iam::*:role/cdk-hnb659fds-cfn-exec-role-*"
      ] } }
    }
  ]
}

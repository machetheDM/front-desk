{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideCapeTownAndFrankfurt",
      "Effect": "Deny",
      "NotAction": [
        "account:*",
        "acm:*",
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "budgets:*",
        "ce:*",
        "cloudfront:*",
        "cur:*",
        "freetier:*",
        "health:*",
        "iam:*",
        "identitystore:*",
        "invoicing:*",
        "kms:*",
        "notifications:*",
        "organizations:*",
        "payments:*",
        "pricing:*",
        "route53:*",
        "route53domains:*",
        "s3:GetAccountPublicAccessBlock",
        "s3:GetBucketLocation",
        "s3:ListAllMyBuckets",
        "sso:*",
        "sts:*",
        "support:*",
        "tax:*",
        "trustedadvisor:*",
        "waf:*",
        "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "af-south-1",
            "eu-central-1"
          ]
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/FrontDeskBreakGlass"
          ]
        }
      }
    }
  ]
}
